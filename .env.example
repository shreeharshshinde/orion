# Orion — environment variable reference
# Copy to .env and fill in values for local development.
# In production, inject via Kubernetes Secrets / ConfigMaps.

# ── Service ───────────────────────────────────────────────────────────────────
ORION_ENV=development           # development | staging | production
ORION_LOG_LEVEL=info            # debug | info | warn | error
ORION_HTTP_PORT=8080
ORION_GRPC_PORT=9090

# ── Database ──────────────────────────────────────────────────────────────────
ORION_DATABASE_DSN=postgres://orion:orion@localhost:5432/orion?sslmode=disable
ORION_DB_MAX_CONNS=20
ORION_DB_MIN_CONNS=2
ORION_DB_MAX_CONN_IDLE=10m
ORION_DB_MAX_CONN_LIFETIME=60m

# ── Redis ─────────────────────────────────────────────────────────────────────
ORION_REDIS_ADDR=localhost:6379
ORION_REDIS_PASSWORD=
ORION_REDIS_DB=0
ORION_REDIS_POOL_SIZE=10

# ── Observability ─────────────────────────────────────────────────────────────
ORION_METRICS_PORT=9091
ORION_OTLP_ENDPOINT=http://localhost:4317
ORION_TRACING_SAMPLE_RATE=1.0   # 0.1 in production
ORION_SERVICE_VERSION=dev

# ── Scheduler ─────────────────────────────────────────────────────────────────
ORION_SCHEDULER_BATCH_SIZE=50
ORION_SCHEDULER_INTERVAL=2s
ORION_SCHEDULER_ORPHAN_INTERVAL=30s

# ── Worker ────────────────────────────────────────────────────────────────────
ORION_WORKER_ID=                # defaults to hostname
ORION_WORKER_CONCURRENCY=10
ORION_WORKER_VISIBILITY_TIMEOUT=5m
ORION_WORKER_HEARTBEAT_INTERVAL=15s
ORION_WORKER_SHUTDOWN_TIMEOUT=30s

# ── Kubernetes ────────────────────────────────────────────────────────────────
ORION_K8S_IN_CLUSTER=false
KUBECONFIG=~/.kube/config
ORION_K8S_NAMESPACE=orion-jobs

# ── Queue rate limits (Phase 8) ───────────────────────────────────────────────
ORION_QUEUE_HIGH_RATE_PER_SEC=100
ORION_QUEUE_HIGH_BURST=20
ORION_QUEUE_HIGH_WEIGHT=0.8
ORION_QUEUE_DEFAULT_RATE_PER_SEC=50
ORION_QUEUE_DEFAULT_BURST=10
ORION_QUEUE_DEFAULT_WEIGHT=0.6
ORION_QUEUE_LOW_RATE_PER_SEC=10
ORION_QUEUE_LOW_BURST=5
ORION_QUEUE_LOW_WEIGHT=0.2
